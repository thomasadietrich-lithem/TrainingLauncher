<?xml version="1.0" encoding="utf-8"?>
<!-- Paquet MSIX du lanceur NeuroVision (Microsoft Store). Document directeur, chapitre 16.
     Les valeurs __...__ sont remplacées par le workflow : identité réservée dans Partner Center (variables du dépôt
     MSIX_NOM, MSIX_EDITEUR, MSIX_EDITEUR_AFFICHE) ou identité de TEST pour l'essai d'installation en CI. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">
  <Identity Name="__NOM__" Publisher="__EDITEUR__" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>NeuroVision Solidaire</DisplayName>
    <PublisherDisplayName>__EDITEUR_AFFICHE__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Lanceur des exercices d'entraînement visuel prescrits par NeuroVision Solidaire.</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="fr-FR" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="NeuroVision" Executable="NeuroVision.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="NeuroVision Solidaire"
                          Description="Exercices d'entraînement visuel prescrits par NeuroVision Solidaire"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="NeuroVision.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="NeuroVisionSolidaire.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
